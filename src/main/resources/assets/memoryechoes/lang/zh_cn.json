  "recall.memoryechoes.1": "过去回应了。",
  "recall.memoryechoes.2": "遗忘的记忆在共鸣。",
  "recall.memoryechoes.3": "旧日的回响苏醒。",
  "recall.memoryechoes.4": "这件工具记得。",
  "recall.memoryechoes.5": "碎片归来。",
  "recall.memoryechoes.6": "时间留下了痕迹。",
  "recall.memoryechoes.7": "过去仍未散去。",
  "recall.memoryechoes.8": "回响应你所唤。",
  "recall.memoryechoes.9": "久埋之物微微动了。",
  "recall.memoryechoes.10": "它并未忘记。",
  "recall.memoryechoes.11": "磨损的刃口记得自己的形状。",
  "recall.memoryechoes.12": "旧日的活计回来了。",
  "recall.memoryechoes.13": "每道伤痕都有来历。",
  "recall.memoryechoes.14": "沉默的岁月浮上来。",
  "recall.memoryechoes.15": "石头记得那一击。",
  "recall.memoryechoes.16": "耗去的又回来了。",
  "recall.memoryechoes.17": "旧习仍在。",
  "recall.memoryechoes.18": "久用的分量沉下来。",
  "recall.memoryechoes.19": "记忆补回了磨损带走的。",
  "recall.memoryechoes.20": "它熟悉这活。",
  "recall.memoryechoes.21": "远去的日子回来片刻。",
  "recall.memoryechoes.22": "工具重新稳住。",
  "recall.memoryechoes.23": "一丝轻响，随后归于安静。",
  "recall.memoryechoes.24": "旧时的力气被记起。",
  "recall.memoryechoes.25": "它取用自己曾是的模样。",
  "recall.memoryechoes.26": "没有什么真正耗尽。",
  "recall.memoryechoes.27": "岁月还回了一些。",
  "recall.memoryechoes.28": "它记得完好时的自己。",
  "recall.memoryechoes.29": "每一次挥动的回响。",
  "recall.memoryechoes.30": "过去尚未终结。",
  "recall.memoryechoes.31": "长久的劳作回应了。",
  "recall.memoryechoes.32": "比金属更古老的什么。",
  "recall.memoryechoes.33": "它做过这个。",
  "recall.memoryechoes.34": "熟悉的地面，被记起。",
  "recall.memoryechoes.35": "旧日的形状重新立住。",
  "recall.memoryechoes.36": "更深处传来的回响。",
  "recall.memoryechoes.37": "靠习惯支撑着。",
  "recall.memoryechoes.38": "它记得那份重量。",
  "recall.memoryechoes.39": "一段记忆浮起，又沉下。",
  "recall.memoryechoes.40": "时间短暂地松了手。",
  "recall.memoryechoes.41": "那些活计没有被忘记。",
  "recall.memoryechoes.42": "有什么自往昔应答。",
  "recall.memoryechoes.43": "旧日的时辰回到它身上。",
  "recall.memoryechoes.44": "它重新聚拢自己。",
  "recall.memoryechoes.45": "过去偿还的一笔债。",
  "recall.memoryechoes.46": "磨损了，却仍记得。",
  "recall.memoryechoes.47": "回响再度平息。",
  "recall.memoryechoes.48": "它继续走下去。",

  "journal.memoryechoes.page.1": "我曾以为，每一件工具生来都是空的。\n\n我错了。",
  "journal.memoryechoes.page.2": "钢记得。\n\n石记得。\n\n连木头也记得。\n\n只是我们忘了如何去听。",
  "journal.memoryechoes.page.3": "有时，在足够多的劳作之后——\n\n我听见它们。\n\n不是人声。\n\n是回响。",
  "journal.memoryechoes.page.4": "握住工具。\n\n站定。\n\n让手安静下来。\n\n过去，回应愿意倾听的人。",
  "journal.memoryechoes.page.5": "我曾害怕换掉一位老伙伴。\n\n于是我把新的放上铁砧，又把旧的搁在它旁边。\n\n钢会断。\n\n记忆不会。",
  "journal.memoryechoes.page.6": "没有什么真正失去。\n\n只是被换了一种方式记住。"
}
